ty\",signIn:\"Sign In\",createAccount:\"Create Account\"},subtitles:{title:\"Subtitles\",settings:\"Settings\",loadingSubtitles:\"Loading subtitles...\",failedToLoadSubtitles:\"Failed to load subtitles\",off:\"Off\",cc:\"(CC)\",version:\"Version\",standard:\"Standard\",noSubtitleTracks:\"No subtitle tracks available\",subtitleSize:\"Subtitle Size\",small:\"Small\",large:\"Large\",default:\"Default\",subtitlePosition:\"Subtitle Position\",bottom:\"Bottom\",top:\"Top\",subtitleBackground:\"Subtitle Background\",enableBackground:\"Enable Background\",backgroundColor:\"Background Color\",transparent:\"Transparent\",opaque:\"Opaque\",resetToDefaults:\"Reset to Defaults\"},loading:{loadingVideo:\"Loading video...\",switchingServer:\"Switching Server\",retry:\"Retry {attempt}/3\"},controls:{play:\"Play\",pause:\"Pause\",replay:\"Replay\",mute:\"Mute\",unmute:\"Unmute\",fullscreen:\"Enter fullscreen\",exitFullscreen:\"Exit fullscreen\",seekForward:\"Seek forward 10 seconds\",seekBackward:\"Seek backward 10 seconds\",nextEpisode:\"Next episode\",previousEpisode:\"Previous episode\",skipIntro:\"Skip intro\",episodes:\"Episodes\",servers:\"Servers\",audio:\"Audio\",quality:\"Quality\"}},O={features:{private:\"PRIVATE\",fast:\"FAST\",personalized:\"PERSONALIZED\"},welcomeBack:\"Welcome back\",version:\"v{version}\"},V={title:\"Settings\",description:\"Customize your experience and manage your account preferences\",appSettings:\"App Settings\",privacyLocation:\"Privacy & Location\",accountSettings:\"Account Settings\",dataManagement:\"Data Management\",adsSettings:\"Ads Settings\",language:\"Language\",languageDescription:\"Choose your preferred language for the interface\",selectLanguage:\"Select your language\",showIntroAnimation:\"Show Intro Animation\",showIntroAnimationDesc:\"Enable or disable the FLIXER intro animation on site start\",defaultGridView:\"Default Grid View\",defaultGridViewDesc:\"Show content in grid layout by default instead of list view\",enableHoverOverlay