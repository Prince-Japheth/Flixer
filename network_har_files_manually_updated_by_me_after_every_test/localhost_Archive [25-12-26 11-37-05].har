          "content": {
            "mimeType": "text/html; charset=utf-8",
            "size": 34742,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n\n    <title>FLIXER - Your Premium Streaming Platform</title>\n\n    <meta name=\"description\" content=\"Stream your favorite movies and TV shows on FLIXER\" />\n    <meta name=\"build-version\" content=\"__BUILD_VERSION__\" />\n    <meta name=\"build-hash\" content=\"__BUILD_HASH__\" />\n\n    <!-- ADS -->\n    <meta name=\"monetag\" content=\"df54d8c79336ff2635141cf502be8953\">\n\n    <!-- Analytics -->\n    <!-- <script defer src=\"https://stats.menochi.su/script.js\" data-website-id=\"67a329a5-9a04-4d4a-a062-07a6555588f9\"></script> -->\n\n    <!-- PWA Meta Tags -->\n    <meta name=\"theme-color\" content=\"#E50914\" />\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"application-name\" content=\"FLIXER\" />\n\n    <!-- iOS Meta Tags -->\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"FLIXER\" />\n\n    <!-- Firefox Meta Tags -->\n    <meta name=\"mozilla\" content=\"yes\" />\n    <meta name=\"mozilla-fullscreen\" content=\"yes\" />\n    <meta name=\"supported-color-schemes\" content=\"light dark\" />\n\n    <!-- Icons -->\n    <link rel=\"icon\" href=\"/assets/icons/favicon.ico\" sizes=\"any\" />\n    <link rel=\"apple-touch-icon\" href=\"/assets/icons/apple-touch-icon.png\" />\n    <link rel=\"mask-icon\" href=\"https://flixer.sh/assets/icons/mask-icon.svg\" color=\"#E50914\" />\n\n    <!-- Manifest -->\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\" crossorigin=\"use-credentials\" />\n    <meta name=\"description\" content=\"Unlimited movies & shows. Stream instantly on Flixer.\" />\n    <meta property=\"og:title\" content=\"Flixer - Your Ultimate Streaming Destination\" />\n    <meta property=\"og:description\" content=\"Unlimited movies & shows. Stream instantly on Flixer.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"Flixer\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"Flixer - Your Ultimate Streaming Destination\" />\n    <meta name=\"twitter:description\" content=\"Unlimited movies & shows. Stream instantly on Flixer.\" />\n    <meta name=\"robots\" content=\"index, follow\" />\n\n    <link rel=\"canonical\" href=\"index.html\" />\n    <link rel=\"sitemap\" type=\"application/xml\" href=\"/assets/sitemaps/sitemap.xml\" />\n\n    <!-- hreflang tags for international SEO -->\n    <link rel=\"alternate\" hreflang=\"en\" href=\"en.html\" />\n    <link rel=\"alternate\" hreflang=\"es\" href=\"es.html\" />\n    <link rel=\"alternate\" hreflang=\"fr\" href=\"fr.html\" />\n    <link rel=\"alternate\" hreflang=\"de\" href=\"de.html\" />\n    <link rel=\"alternate\" hreflang=\"it\" href=\"it.html\" />\n    <link rel=\"alternate\" hreflang=\"pt\" href=\"pt.html\" />\n    <link rel=\"alternate\" hreflang=\"nl\" href=\"nl.html\" />\n    <link rel=\"alternate\" hreflang=\"ru\" href=\"ru.html\" />\n    <link rel=\"alternate\" hreflang=\"ja\" href=\"ja.html\" />\n    <link rel=\"alternate\" hreflang=\"ko\" href=\"ko.html\" />\n    <link rel=\"alternate\" hreflang=\"zh\" href=\"zh.html\" />\n    <link rel=\"alternate\" hreflang=\"ar\" href=\"ar.html\" />\n    <link rel=\"alternate\" hreflang=\"bn\" href=\"bn.html\" />\n    <link rel=\"alternate\" hreflang=\"hi\" href=\"hi.html\" />\n    <link rel=\"alternate\" hreflang=\"jv\" href=\"jv.html\" />\n    <link rel=\"alternate\" hreflang=\"pa\" href=\"pa.html\" />\n    <link rel=\"alternate\" hreflang=\"pl\" href=\"pl.html\" />\n    <link rel=\"alternate\" hreflang=\"te\" href=\"te.html\" />\n    <link rel=\"alternate\" hreflang=\"tr\" href=\"tr.html\" />\n    <link rel=\"alternate\" hreflang=\"vi\" href=\"vi.html\" />\n    <link rel=\"alternate\" hreflang=\"x-default\" href=\"index.html\" />\n    <link rel=\"preconnect\" href=\"https://image.tmdb.org\">\n    <link rel=\"preconnect\" href=\"https://flixer.sh/api/tmdb\">\n    <link rel=\"dns-prefetch\" href=\"https://image.tmdb.org\">\n    <link rel=\"dns-prefetch\" href=\"https://api.flixer.sh/api/tmdb\">\n\n    <!-- ADS SCRIPT -->\n    <script>\n        function areAdsEnabled() {\n            try {\n                const stored = localStorage.getItem('ads_enabled');\n                return stored ? JSON.parse(stored) : true;\n            } catch (error) {\n                console.error('Error reading ads setting:', error);\n                return true;\n            }\n        }\n\n        function getAdConfig() {\n            const hostname = window.location.hostname;\n\n            if (hostname === 'flixy.watch') {\n                return {\n                    zone: '9885184',\n                    script: 'https://bvtpk.com/tag.min.js',\n                    selector: 'script[data-zone=\"9885184\"]'\n                };\n            } else if (hostname === 'flixer.sh') {\n                return {\n                    zone: '9885184',\n                    script: 'https://bvtpk.com/tag.min.js',\n                    selector: 'script[data-zone=\"9885184\"]'\n                };\n            } else {\n                return {\n                    zone: '9885184',\n                    script: 'https://bvtpk.com/tag.min.js',\n                    selector: 'script[data-zone=\"9885184\"]'\n                };\n            }\n        }\n\n        function loadAdScript() {\n            if (areAdsEnabled()) {\n                const config = getAdConfig();\n                const existingScript = document.querySelector(config.selector);\n\n                if (existingScript) {\n                    existingScript.remove();\n                }\n\n                if (config.zone === '9885184') {\n                    (s => {\n                        s.dataset.zone = '9885184';\n                        s.src = 'https://bvtpk.com/tag.min.js';\n                    })([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')));\n                } else {\n                    (function(s, u, z, p) {\n                        s.src = u, s.setAttribute('data-zone', z), p.appendChild(s);\n                    })(document.createElement('script'), config.script, config.zone, document.body || document.documentElement);\n                }\n            } else {\n                const flixyScript = document.querySelector('script[data-zone=\"9885184\"]');\n                const flixerScript = document.querySelector('script[data-zone=\"9885184\"]');\n\n                if (flixyScript) flixyScript.remove();\n                if (flixerScript) flixerScript.remove();\n            }\n        }\n\n        loadAdScript();\n\n        window.addEventListener('storage', function(e) {\n            if (e.key === 'ads_enabled') {\n                loadAdScript();\n                if (typeof window.umami?.track === 'function') {\n                    try {\n                        const newValue = e.newValue ? JSON.parse(e.newValue) : true;\n                        const eventName = newValue ? 'ads-on' : 'ads-off';\n                        window.umami.track(eventName);\n                        localStorage.setItem('ads_status_last_tracked', newValue ? 'enabled' : 'disabled');\n                    } catch (error) {\n                        console.error('Error tracking ads status change from storage:', error);\n                    }\n                }\n            }\n        });\n        window.loadAdScript = loadAdScript;\n\n        function trackAdsStatusEvent() {\n            if (typeof window.umami?.track !== 'function') {\n                setTimeout(trackAdsStatusEvent, 200);\n                return;\n            }\n\n            const adsEnabled = areAdsEnabled();\n            const eventSentKey = 'ads_status_event_sent';\n            const lastStatusKey = 'ads_status_last_tracked';\n            \n            const lastTrackedStatus = localStorage.getItem(lastStatusKey);\n            const currentStatus = adsEnabled ? 'enabled' : 'disabled';\n            \n            const hasSentInitial = localStorage.getItem(eventSentKey) === 'true';\n            \n            if (!hasSentInitial) {\n                try {\n                    const eventName = adsEnabled ? 'ads-on' : 'ads-off';\n                    window.umami.track(eventName);\n                    \n                    localStorage.setItem(eventSentKey, 'true');\n                    localStorage.setItem(lastStatusKey, currentStatus);\n                } catch (error) {\n                    console.error('Error tracking ads status event:', error);\n                }\n            } else if (lastTrackedStatus !== currentStatus) {\n                try {\n                    const eventName = adsEnabled ? 'ads-on' : 'ads-off';\n                    window.umami.track(eventName);\n                    \n                    localStorage.setItem(lastStatusKey, currentStatus);\n                } catch (error) {\n                    console.error('Error tracking ads status event:', error);\n                }\n            }\n        }\n\n        trackAdsStatusEvent();\n\n        window.trackAdsStatusEvent = trackAdsStatusEvent;\n    </script>\n\n    <!--International SEO Tags-->\n    <script>\n        (function() {\n            const SEO_META_TRANSLATIONS = {\n                en: {\n                    title: 'FLIXER - Your Premium Streaming Platform',\n                    description: 'Unlimited movies & shows. Stream instantly on Flixer.',\n                    ogTitle: 'Flixer - Your Ultimate Streaming Destination',\n                    ogDescription: 'Unlimited movies & shows. Stream instantly on Flixer.',\n                    twitterTitle: 'Flixer - Your Ultimate Streaming Destination',\n                    twitterDescription: 'Unlimited movies & shows. Stream instantly on Flixer.'\n                },\n                es: {\n                    title: 'FLIXER - Tu Plataforma de Streaming Premium',\n                    description: 'Películas y series ilimitadas. Transmite al instante en Flixer.',\n                    ogTitle: 'Flixer - Tu Destino de Streaming Definitivo',\n                    ogDescription: 'Películas y series ilimitadas. Transmite al instante en Flixer.',\n                    twitterTitle: 'Flixer - Tu Destino de Streaming Definitivo',\n                    twitterDescription: 'Películas y series ilimitadas. Transmite al instante en Flixer.'\n                },\n                fr: {\n                    title: 'FLIXER - Votre Plateforme de Streaming Premium',\n                    description: 'Films et séries illimités. Diffusez instantanément sur Flixer.',\n                    ogTitle: 'Flixer - Votre Destination de Streaming Ultime',\n                    ogDescription: 'Films et séries illimités. Diffusez instantanément sur Flixer.',\n                    twitterTitle: 'Flixer - Votre Destination de Streaming Ultime',\n                    twitterDescription: 'Films et séries illimités. Diffusez instantanément sur Flixer.'\n                },\n                de: {\n                    title: 'FLIXER - Ihre Premium-Streaming-Plattform',\n                    description: 'Unbegrenzte Filme & Serien. Sofort streamen auf Flixer.',\n                    ogTitle: 'Flixer - Ihr ultimatives Streaming-Ziel',\n                    ogDescription: 'Unbegrenzte Filme & Serien. Sofort streamen auf Flixer.',\n                    twitterTitle: 'Flixer - Ihr ultimatives Streaming-Ziel',\n                    twitterDescription: 'Unbegrenzte Filme & Serien. Sofort streamen auf Flixer.'\n                },\n                it: {\n                    title: 'FLIXER - La Tua Piattaforma di Streaming P