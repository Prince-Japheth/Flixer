_TRANSLATIONS[pathLang]) {\n                    console.log(`Language detected from URL: ${pathLang}`);\n                    return pathLang;\n                }\n                const storedLang = localStorage.getItem('preferred_language');\n                if (storedLang && SEO_META_TRANSLATIONS[storedLang]) {\n                    console.log(`Language detected from localStorage: ${storedLang}`);\n                    return storedLang;\n                }\n                const countryToLang = {\n                    'ES': 'es',\n                    'MX': 'es',\n                    'AR': 'es',\n                    'CO': 'es',\n                    'PE': 'es',\n                    'VE': 'es',\n                    'CL': 'es',\n                    'EC': 'es',\n                    'FR': 'fr',\n                    'CA': 'fr',\n                    'BE': 'fr',\n                    'CH': 'fr',\n                    'DE': 'de',\n                    'AT': 'de',\n                    'CH': 'de',\n                    'IT': 'it',\n                    'SM': 'it',\n                    'VA': 'it',\n                    'BR': 'pt',\n                    'PT': 'pt',\n                    'MZ': 'pt',\n                    'AO': 'pt',\n                    'NL': 'nl',\n                    'BE': 'nl',\n                    'SR': 'nl',\n                    'RU': 'ru',\n                    'BY': 'ru',\n                    'KZ': 'ru',\n                    'KG': 'ru',\n                    'JP': 'ja',\n                    'KR': 'ko',\n                    'CN': 'zh',\n                    'TW': 'zh',\n                    'HK': 'zh',\n                    'SG': 'zh',\n                    'SA': 'ar',\n                    'AE': 'ar',\n                    'EG': 'ar',\n                    'JO': 'ar',\n                    'LB': 'ar',\n                    'SY': 'ar',\n                    'IQ': 'ar',\n                    'BD': 'bn',\n                    'IN': 'hi',\n                    'ID': 'jv',\n                    'PK': 'pa',\n                    'IN': 'pa',\n                    'PL': 'pl',\n                    'TR': 'tr',\n                    'VN': 'vi'\n                };\n                if (window.userCountry && countryToLang[window.userCountry]) {\n                    const langFromCountry = countryToLang[window.userCountry];\n                    console.log(`Language detected from country ${window.userCountry}: ${langFromCountry}`);\n                    return langFromCountry;\n                }\n                const browserLang = navigator.language.split('-')[0];\n                if (SEO_META_TRANSLATIONS[browserLang]) {\n                    console.log(`Language detected from browser: ${browserLang}`);\n                    return browserLang;\n                }\n                console.log('Language defaulted to English');\n                return 'en';\n            }\n            const seoDetectedLang = detectSEOLanguage();\n            updateMetaTagsForLanguage(seoDetectedLang);\n            window.addEventListener('storage', function(e) {\n                if (e.key === 'preferred_language' && e.newValue) {\n                    updateMetaTagsForLanguage(e.newValue);\n                }\n            });\n            let lastSEOLang = seoDetectedLang;\n            setInterval(() => {\n                const currentLang = localStorage.getItem('preferred_language') || seoDetectedLang;\n                if (currentLang !== lastSEOLang) {\n                    updateMetaTagsForLanguage(currentLang);\n                    lastSEOLang = currentLang;\n                }\n            }, 1000);\n            window.updateMetaTagsForLanguage = updateMetaTagsForLanguage;\n            window.SEO_META_TRANSLATIONS = SEO_META_TRANSLATIONS;\n        })();\n    </script>\n  <script>\n    // Register service worker to intercept requests\n    if ('serviceWorker' in navigator) {\n      // Only register if not already registered to avoid refresh loops\n      navigator.serviceWorker.getRe